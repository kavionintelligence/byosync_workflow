# Copy to .env.local or set in Vercel → Project → Settings → Environment Variables.
# Never commit secrets.

# -----------------------------------------------------------------------------
# PRODUCTION ON VERCEL (required for durable waitlist storage)
# -----------------------------------------------------------------------------
# Vercel serverless has no persistent disk. Signups are stored in Upstash Redis.
# https://upstash.com → Redis → REST URL + token
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret for CSV download (pick a long random string).
# GET https://YOUR-DOMAIN/api/waitlist/export?token=YOUR_TOKEN
WAITLIST_EXPORT_TOKEN=

# -----------------------------------------------------------------------------
# LOCAL DEVELOPMENT
# -----------------------------------------------------------------------------
# Without Redis, signups append to data/waitlist.csv only (same machine).
