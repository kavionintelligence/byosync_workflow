# Copy to .env.local and fill in. Never commit .env.local.

# Email each waitlist signup to varun.k@byosync.in (override with WAITLIST_NOTIFY_EMAIL).
# Get an API key at https://resend.com — verify your sending domain or use onboarding@resend.dev for tests.
RESEND_API_KEY=

# Optional — must be a verified sender in Resend (e.g. notify@yourdomain.com)
# RESEND_FROM=ByoSync <notify@byosync.in>

# Optional — defaults to varun.k@byosync.in
# WAITLIST_NOTIFY_EMAIL=varun.k@byosync.in

# Download CSV: https://your-domain.com/api/waitlist/export?token=YOUR_SECRET
WAITLIST_EXPORT_TOKEN=
