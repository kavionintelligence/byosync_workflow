# Copy to .env.local or set in Vercel → Project → Settings → Environment Variables.
# Never commit secrets.

# -----------------------------------------------------------------------------
# PRODUCTION ON VERCEL (do at least one)
# -----------------------------------------------------------------------------

# 1) EMAIL TO YOU (required if you are not using Redis)
#    Create https://resend.com → API Keys → add key here.
#    Verify a domain at Resend, then set RESEND_FROM to e.g. ByoSync <waitlist@yourdomain.com>
#    Messages go to WAITLIST_NOTIFY_EMAIL (default: varun.k@byosync.in).
#    Reply-To is set to the applicant so you can respond from your inbox.
RESEND_API_KEY=

RESEND_FROM=

# Optional — default varun.k@byosync.in
# WAITLIST_NOTIFY_EMAIL=varun.k@byosync.in

# 2) SPREADSHEET EXPORT (optional but recommended)
#    https://upstash.com → Redis → REST URL + token
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Download: https://YOUR-DOMAIN/api/waitlist/export?token=SECRET
WAITLIST_EXPORT_TOKEN=

# -----------------------------------------------------------------------------
# LOCAL DEVELOPMENT
# -----------------------------------------------------------------------------
# Without Redis/Resend, signups save to data/waitlist.csv only (not for Vercel).
