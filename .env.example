# Copy to .env.local (local) or Vercel → Project → Settings → Environment Variables.

# --- Vercel / production (pick at least one storage path) ---

# A) Persistent database for all signups (recommended on Vercel — free tier: https://upstash.com )
#    Create a Redis database → copy REST URL + REST token into Vercel env.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# B) Email each signup to varun.k@byosync.in (https://resend.com)
RESEND_API_KEY=

# Optional Resend sender — use a verified domain in production
# RESEND_FROM=ByoSync <notify@byosync.in>

# Optional — defaults to varun.k@byosync.in
# WAITLIST_NOTIFY_EMAIL=varun.k@byosync.in

# Download spreadsheet: https://YOUR-DOMAIN.vercel.app/api/waitlist/export?token=YOUR_SECRET
WAITLIST_EXPORT_TOKEN=

# --- Local dev only ---
# Without Redis/Resend, signups still save to data/waitlist.csv on your machine.
